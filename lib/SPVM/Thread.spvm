class Thread {
  version "0.010";
  
  use Callback;
  use Thread::ID;
  
  # Fields
  has task : Callback;
  
  has caller_info : CallerInfo;
  
  # Class Methods
  static method new : Thread ($task : Callback) {
    
    my $self = new Thread;
    
    $self->{task} = $task;
    
    my $caller_info = caller;
    $self->{caller_info} = $caller_info;
    
    $self->create;
    
    return $self;
  }
  
  # Instance Methods
  native private method create : void ();
  
  native method join : void ();
  
  native method get_id : Thread::ID ();
  
  native method DESTROY : void ();
}
